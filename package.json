{
  "name": "gh-manager-cli",
  "version": "1.53.4",
  "private": false,
  "description": "TUI terminal app to manage GitHub repos. Clean up your account in 5 minutes. Archive, delete, rename repos with keyboard shortcuts. Alternative to clicking through github.com",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": {
    "gh-manager-cli": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "github",
    "cli",
    "repository",
    "management",
    "terminal",
    "tui",
    "react-ink",
    "github-cli",
    "github-manager",
    "repo-manager",
    "repository-cleanup",
    "github-cleanup",
    "archive-repos",
    "delete-repos",
    "github-api",
    "developer-tools",
    "productivity",
    "github-tools",
    "terminal-ui",
    "interactive-cli",
    "ink",
    "graphql"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "build:binaries": "pnpm run build && pnpm exec pkg dist/index.js --targets node22-linux-x64,node22-macos-x64,node22-windows-x64 --out-path ./binaries",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:debug": "GH_MANAGER_DEBUG=1 node dist/index.js",
    "start:dev": "REPOS_PER_FETCH=5 GH_MANAGER_DEBUG=1 node dist/index.js",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "brew:sha": "bash scripts/brew-sha.sh",
    "assets:png": "bash scripts/convert-svg-to-png.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@apollo/client": "^3.14.0",
    "@octokit/graphql": "^9.0.5",
    "apollo3-cache-persist": "^0.15.0",
    "chalk": "^6.0.0",
    "dotenv": "^18.0.9",
    "env-paths": "^4.0.0",
    "fuse.js": "^7.4.2",
    "graphql": "^16.14.2",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.4",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@yao-pkg/pkg": "^6.23.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stealth-factory/gh-manager-cli.git"
  },
  "bugs": {
    "url": "https://github.com/stealth-factory/gh-manager-cli/issues"
  },
  "homepage": "https://gh-manager-cli.dev",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "overrides": {
      "@actions/http-client>undici": "6.29.1",
      "@semantic-release/github>undici": "7.30.1",
      "@yao-pkg/pkg-fetch>undici": "7.30.1"
    }
  }
}
